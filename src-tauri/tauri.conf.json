{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Code",
  "version": "1.0.0",
  "identifier": "com.zhoujunjie.orbitcode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Orbit Code",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 760,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 22, "y": 27 },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first multi-model coding agent desktop workspace",
    "longDescription": "Orbit Code is a cross-platform desktop application that provides a local-first, multi-model coding agent workbench with reviewable agent execution, transactional patch workflows, and multi-provider model imports.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}

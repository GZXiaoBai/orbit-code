{
  "name": "orbit-code",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first multi-model coding agent workbench",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:codex-sidecar": "node scripts/prepare-codex-sidecar.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "smoke:desktop-readiness": "node scripts/run-tauri-webdriver-readiness.mjs",
    "smoke:desktop-plan": "node scripts/run-tauri-webdriver-plan-smoke.mjs",
    "smoke:desktop-build": "node scripts/run-tauri-webdriver-build-smoke.mjs",
    "smoke:desktop-build:deny": "ORBIT_DESKTOP_BUILD_DENY=1 node scripts/run-tauri-webdriver-build-smoke.mjs",
    "smoke:live-vault:bootstrap": "node scripts/bootstrap-live-vault.mjs",
    "smoke:plan": "node scripts/run-plan-stability-smoke.mjs",
    "smoke:plan-route": "node scripts/run-plan-route-smoke.mjs",
    "smoke:plan-live": "node scripts/run-plan-live-streaming-smoke.mjs",
    "smoke:deepseek": "node scripts/run-codex-app-server-smoke.mjs",
    "smoke:deepseek:live-readiness": "node scripts/run-codex-live-readiness.mjs",
    "smoke:deepseek:live-app-server": "node scripts/run-codex-live-app-server-smoke.mjs",
    "smoke:deepseek:bridge-unit": "node scripts/run-codex-bridge-smoke.mjs",
    "smoke:deepseek:legacy": "node scripts/run-deepseek-smoke.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.60.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
